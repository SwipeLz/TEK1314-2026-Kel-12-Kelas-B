[Unit]
Description=SmartCow Lab - broker MQTT replika
After=network.target

[Service]
Type=simple
User=smartcow
Group=smartcow
WorkingDirectory=/home/smartcow-lab
EnvironmentFile=/home/smartcow-lab/mqtt.env
ExecStart=/usr/bin/python3 /home/smartcow-lab/broker.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
